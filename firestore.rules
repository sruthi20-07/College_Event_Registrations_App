rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@collegeevent.com' ||
        request.auth.token.email == 'admin@college.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'faculty', 'coordinator'])
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Registrations collection
    match /registrations/{registrationId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );

      // Students can create their own registration (initially unattended)
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      ) && request.resource.data.attended != true;

      // Admins can verify & record attendance; students cannot tamper with attendance fields
      allow update: if isAdmin() || (
        isAuthenticated() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ) &&
        // Prevent student from directly marking themselves attended or forging attendance fields
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'attended', 'attendanceStatus', 'attendedAt', 'verifiedByAdminUid', 'verifiedByAdminEmail', 'checkInMethod', 'attendanceSessionId'
        ])
      );

      allow delete: if isAdmin();
    }

    // Live Attendance Sessions collection (Admin generated rotating QR sessions)
    match /attendance_sessions/{sessionId} {
      // Authenticated users can read session info; only admins can create, rotate, or close sessions
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Attendance verification audit logs collection
    match /attendance/{attendanceId} {
      // Only authenticated admins can read or write attendance audit logs
      allow read: if isAdmin();
      allow write: if isAdmin();
    }


    // Gamification & Rewards profile collection
    match /gamification/{studentId} {
      // Authenticated users can read gamification profiles (needed for leaderboard and profile)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == studentId || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == studentId &&
        // Prevent student from arbitrarily inflating lifetime achievement coins or attended events directly
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lifetimeCoins', 'totalEventsAttended', 'longestStreak'
        ])
      );
      allow delete: if isAdmin();
    }

    // Reward history collection (idempotency ledger)
    match /reward_history/{rewardId} {
      // Students can read their own reward history; admins can read all
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      // Admins can write all entries; students can create their own debit transaction during redemption
      allow create: if isAdmin() || (
        isAuthenticated() && request.resource.data.studentId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Rewards Catalogue collection
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reward Redemptions collection
    match /redemptions/{redemptionId} {
      // Students can read their own redemptions; admins can read all
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.studentId == request.auth.uid
      );
      // Students can create their own redemption request; admins can create all
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAdmin()
      );
      // Only admins can approve, fulfil, reject, or delete redemptions
      allow update, delete: if isAdmin();
    }

    // Gamification Earning Rules collection
    match /gamification_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerUid == request.auth.uid ||
        resource.data.referredUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Saved events collection
    match /saved_events/{savedId} {
      allow read, write: if isAuthenticated();
    }

    // App Feedback & Reviews collection
    match /app_feedback/{feedbackId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.studentUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentUid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // WhatsApp Notification Tracking Logs collection
    match /notification_logs/{logId} {
      // Students can read their own notification status; admins can read all
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.studentId == request.auth.uid
      );
      // Students can queue/record notification requests for their own account
      allow create, update: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.studentId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
